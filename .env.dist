SUNRISE_DASHBOARD_URL=http://localhost:9990
# Register SUNRISE_DASHBOARD_URL with a trailing slash as a valid post-logout redirect
# URI on the confidential Keycloak client (for example, http://localhost:9990/).
# Optional exact, comma-separated additional origins for alternate ports on the
# same scheme and hostname. SUNRISE_DASHBOARD_URL is always trusted. Cross-host,
# cross-scheme, and wildcard entries are ignored because authentication uses a
# host-only cookie and the canonical OIDC callback. Reverse proxies must
# overwrite X-Forwarded-Host and X-Forwarded-Proto.
# SUNRISE_ALLOWED_DASHBOARD_ORIGINS=http://localhost:9991
# Use at least 32 random characters and keep the value stable across every replica
# and rolling deployment. Rotating it invalidates all active sessions.
SUNRISE_SESSION_SECRET=replace_me
# Sunrise bounds renewable Keycloak, Keystone, and Object Storage sessions.
# Both values are seconds; activity extends only the idle deadline, never the
# absolute deadline. The idle timeout must not exceed the absolute timeout.
SUNRISE_SESSION_IDLE_TIMEOUT_SECONDS=1800
SUNRISE_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Server log output. Production defaults to one-line JSON for ingestion by
# Kubernetes and log collectors; source development defaults to readable text.
# Supported levels: debug, info, warn, error. Supported formats: json, pretty.
SUNRISE_LOG_LEVEL=info
# SUNRISE_LOG_FORMAT=json

# Session persistence. `cookie` preserves the single-process development
# fallback. `redis` stores only an opaque reference in the browser and keeps
# the credential-bearing session payload in Redis so replicas can share,
# revoke, and coordinate it without load-balancer affinity.
SUNRISE_SESSION_BACKEND=cookie
# Required when the Redis session backend is selected. Use `rediss://` with an
# authenticated endpoint in production. Supply a stable writable endpoint, not
# a Sentinel port; the local Compose stack overrides this value.
# SUNRISE_REDIS_URL=redis://redis:6379
# Optional ACL credentials. Keeping them separate avoids embedding secrets in
# SUNRISE_REDIS_URL and maps cleanly to Kubernetes Secret references. A password
# without a username authenticates as Redis's default user.
# SUNRISE_REDIS_USERNAME=sunrise
# SUNRISE_REDIS_PASSWORD=insert_redis_password
# Optional PEM CA bundle for a rediss:// endpoint using private PKI. Mount the
# file into every Sunrise replica and provide its in-container path here.
# SUNRISE_REDIS_CA_FILE=/run/secrets/redis/ca.crt
# Fail a request promptly when an established Redis connection stops
# responding. Connection establishment is separately bounded to 1500 ms.
SUNRISE_REDIS_COMMAND_TIMEOUT_MS=2000
# Namespace every shared key so several Sunrise deployments can safely use one
# Redis service. Changing this value invalidates existing server-side sessions.
SUNRISE_REDIS_KEY_PREFIX=sunrise

# Next.js deployment identifier. Source-tree development can omit it; container
# builds require one value per immutable build. Pass it as the Docker build
# argument and use the baked runtime value on every replica serving that image
# so Next.js can detect version skew during rolling deployments. Do not override
# it in Kubernetes.
# SUNRISE_DEPLOYMENT_ID=git-commit-sha

# Container builds also require a stable Server Actions encryption key through
# a BuildKit secret named `next_server_actions_encryption_key`. This is a build-
# time input embedded by Next.js, not a runtime environment variable or Helm
# Secret. Reuse one random base64-encoded 16, 24, or 32-byte key across builds
# that can overlap during a rolling deployment. Also pass a non-secret
# SUNRISE_SERVER_ACTIONS_KEY_ID build argument and change it whenever the secret
# changes; BuildKit secret contents do not invalidate cached build layers.
# Compose supplies a public local-development key and matching revision; never
# use that key for a published image.

# Deployment palette. Appearance remains a per-user light/dark/system choice.
# Supported values: sunrise, vexxhost
SUNRISE_COLOR_PALETTE=sunrise

# Service exposure policy. Disabled services are removed from navigation,
# search, create actions, background checks, and their direct Sunrise routes.
# Supported IDs: compute, image, volume, network, load-balancer,
# container-infra, object-storage-s3, object-storage, identity, orchestration,
# dns, share, key-manager. IDs are stable, versionless OpenStack service types;
# catalog types such as `volumev3` and `sharev2` are resolved internally.
# `object-storage-s3` controls Sunrise's S3 implementation; `object-storage`
# is the Keystone catalog identifier for Swift. Disable both to hide Object
# Storage completely. Disabling one backend still permits fallback to the other.
SUNRISE_DISABLED_SERVICES=
# Optional per-region overrides use one comma-separated variable per region.
# Sunrise converts region IDs to uppercase and replaces runs of non-alphanumeric
# characters with `_`. For example, `Region-One`, `region_one`, and
# `Region-onE` all use the suffix `REGION_ONE`.
# SUNRISE_DISABLED_SERVICES_REGIONONE="object-storage-s3,dns"

# Ordered Object Storage backend preference. Sunrise selects the first backend
# with a public catalog endpoint in the active region. Supported: s3, swift.
# The default is `swift`; set `s3` explicitly to use the S3 implementation, or
# provide an ordered list such as `s3,swift` to permit fallback.
SUNRISE_OBJECT_STORAGE_BACKENDS=swift

# Server-side Keystone API URL
KEYSTONE_API=http://localhost:15000
# Public Keystone API URL (must be accessible from the browser)
KEYSTONE_PUBLIC_API=http://localhost:15000
KEYSTONE_FEDERATION_IDENTITY_PROVIDERS="atmosphere1,atmosphere2"
# Provider IDs remain exact in Keystone requests and Sunrise sessions. For
# environment-variable overrides, Sunrise converts each ID to uppercase and
# replaces every run of non-alphanumeric characters with `_`. For example,
# `atmosphere-1`, `atmosphere_1`, and `Atmosphere-1` all map to the suffix
# `ATMOSPHERE_1`; configurations with colliding suffixes are rejected.
#
# Provider-specific values take precedence over their unsuffixed global
# fallback. The federation protocol defaults to `openid` when neither is set.
KEYSTONE_FEDERATION_IDENTITY_PROVIDER_PROTOCOL=openid
# KEYSTONE_FEDERATION_IDENTITY_PROVIDER_PROTOCOL_ATMOSPHERE1=openid

# Optional provider display names use the same normalized suffix and must refer
# to a provider from KEYSTONE_FEDERATION_IDENTITY_PROVIDERS. The exact provider
# ID remains the value users enter and the URL segment in `/sign-in/<provider>`
# bookmarks. Display names fall back to that provider ID when omitted.
# For a provider named `demo`:
# SUNRISE_IDENTITY_PROVIDER_DISPLAY_NAME_DEMO="VEXXHOST Demo"
SUNRISE_IDENTITY_PROVIDER_DISPLAY_NAME_ATMOSPHERE1="VEXXHOST Atmosphere 1"

# These settings configure Sunrise's primary confidential OIDC client. Sunrise
# uses them for login, token refresh, Keystone federation, logout, and RGW STS.
# Issuer, client ID, and client secret are required for every configured
# provider after provider-specific/global fallback. When S3 is enabled, each
# client must also be registered in RGW's OIDC provider ClientIDList and its
# access token must include the client ID in `aud`, `rgw_project_roles`, and the
# `https://aws.amazon.com/tags` session-tag claim.
# SUNRISE_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/default
# SUNRISE_KEYCLOAK_CLIENT_ID=sunrise-server
# SUNRISE_KEYCLOAK_CLIENT_SECRET=insert-confidential-client-secret
SUNRISE_KEYCLOAK_ISSUER_ATMOSPHERE1=https://keycloak.example.com/realms/atmosphere1
SUNRISE_KEYCLOAK_CLIENT_ID_ATMOSPHERE1=sunrise-server
SUNRISE_KEYCLOAK_CLIENT_SECRET_ATMOSPHERE1=insert-confidential-client-secret
SUNRISE_KEYCLOAK_ISSUER_ATMOSPHERE2=https://keycloak.example.com/realms/atmosphere2
SUNRISE_KEYCLOAK_CLIENT_ID_ATMOSPHERE2=sunrise-server
SUNRISE_KEYCLOAK_CLIENT_SECRET_ATMOSPHERE2=insert-confidential-client-secret

# The RGW STS duration defaults to 3600 seconds and must be between 900 and
# 43200. RGW still applies the selected role's maximum session duration.
# Provider-specific values override the unsuffixed fallback.
# SUNRISE_RGW_STS_SESSION_DURATION_SECONDS=3600
SUNRISE_RGW_STS_SESSION_DURATION_SECONDS_ATMOSPHERE1=3600
# SUNRISE_RGW_STS_SESSION_DURATION_SECONDS_ATMOSPHERE2=3600

# In Kubernetes, keep non-sensitive values in the workload or a ConfigMap and
# inject each confidential client secret from a Secret. For example:
# env:
#   - name: SUNRISE_KEYCLOAK_CLIENT_SECRET_ATMOSPHERE1
#     valueFrom:
#       secretKeyRef:
#         name: sunrise-oidc
#         key: atmosphere1-client-secret

# Mount a PEM CA bundle and point Node.js at it when Keycloak or OpenStack uses
# private PKI. The same bundle can be referenced by SUNRISE_REDIS_CA_FILE when
# Redis uses that CA. Kubernetes should provide this path from a mounted Secret
# or ConfigMap.
# NODE_EXTRA_CA_CERTS=/run/secrets/platform/ca.crt

# Local debugging only. Never use this in a published image or Helm values;
# startup logs a warning because it disables certificate verification globally.
# NODE_TLS_REJECT_UNAUTHORIZED=0

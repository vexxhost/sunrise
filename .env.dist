DASHBOARD_URL=http://localhost:9990
# Register DASHBOARD_URL with a trailing slash as a valid post-logout redirect
# URI on the confidential Keycloak client (for example, http://localhost:9990/).
SESSION_SECRET=insert_session_secret
# Sunrise bounds renewable Keycloak, Keystone, and Object Storage sessions.
# Both values are seconds; activity extends only the idle deadline, never the
# absolute deadline. The idle timeout must not exceed the absolute timeout.
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800

# Deployment palette. Appearance remains a per-user light/dark/system choice.
# Supported values: sunrise, vexxhost
SUNRISE_COLOR_PALETTE=sunrise

# Service exposure policy. Disabled services are removed from navigation,
# search, create actions, background checks, and their direct Sunrise routes.
# Supported IDs: compute, image, volume, network, load-balancer,
# container-infra, object-storage-s3, object-storage, identity, orchestration,
# dns, share, key-manager. IDs are stable, versionless OpenStack service types;
# catalog types such as `volumev3` and `sharev2` are resolved internally.
# `object-storage-s3` controls Sunrise's S3 implementation; `object-storage`
# is the Keystone catalog identifier for Swift. Disable both to hide Object
# Storage completely. Disabling one backend still permits fallback to the other.
SUNRISE_DISABLED_SERVICES=
# Optional per-region overrides as JSON. Region IDs are case-sensitive.
# SUNRISE_DISABLED_SERVICES_BY_REGION='{"RegionOne":["object-storage-s3","dns"]}'

# Ordered Object Storage backend preference. Sunrise selects the first backend
# with a public catalog endpoint in the active region. Supported: s3, swift.
# Keep `s3` alone for current behavior, or use `s3,swift` for future fallback.
SUNRISE_OBJECT_STORAGE_BACKENDS=s3

# Server-side Keystone API URL
KEYSTONE_API=http://localhost:15000
# Client-side Keystone API URL (must be accessible from browser)
NEXT_PUBLIC_KEYSTONE_API=http://localhost:15000
KEYSTONE_FEDERATION_IDENTITY_PROVIDERS="atmosphere1,atmosphere2"
# Provider IDs remain exact in Keystone requests and Sunrise sessions. For
# environment-variable overrides, Sunrise converts each ID to uppercase and
# replaces every run of non-alphanumeric characters with `_`. For example,
# `atmosphere-1`, `atmosphere_1`, and `Atmosphere-1` all map to the suffix
# `ATMOSPHERE_1`; configurations with colliding suffixes are rejected.
#
# Provider-specific values take precedence over their unsuffixed global
# fallback. The federation protocol defaults to `openid` when neither is set.
KEYSTONE_FEDERATION_IDENTITY_PROVIDER_PROTOCOL=openid
# KEYSTONE_FEDERATION_IDENTITY_PROVIDER_PROTOCOL_ATMOSPHERE1=openid

# These settings configure Sunrise's primary confidential OIDC client. Sunrise
# uses them for login, token refresh, Keystone federation, logout, and the
# optional RGW token exchange. Issuer, client ID, and client secret are required
# for every configured provider after provider-specific/global fallback.
# SUNRISE_KEYCLOAK_ISSUER=https://keycloak.example.com/realms/default
# SUNRISE_KEYCLOAK_CLIENT_ID=sunrise-server
# SUNRISE_KEYCLOAK_CLIENT_SECRET=insert-confidential-client-secret
SUNRISE_KEYCLOAK_ISSUER_ATMOSPHERE1=https://keycloak.example.com/realms/atmosphere1
SUNRISE_KEYCLOAK_CLIENT_ID_ATMOSPHERE1=sunrise-server
SUNRISE_KEYCLOAK_CLIENT_SECRET_ATMOSPHERE1=insert-confidential-client-secret
SUNRISE_KEYCLOAK_ISSUER_ATMOSPHERE2=https://keycloak.example.com/realms/atmosphere2
SUNRISE_KEYCLOAK_CLIENT_ID_ATMOSPHERE2=sunrise-server
SUNRISE_KEYCLOAK_CLIENT_SECRET_ATMOSPHERE2=insert-confidential-client-secret

# Only the RGW client ID and STS duration are S3-specific. A provider without
# an RGW client ID can still sign in and use Keystone services. An explicitly
# empty provider-specific RGW client ID disables a configured global fallback.
# The duration defaults to 3600 seconds and must be between 900 and 43200; RGW
# still applies the selected role's maximum session duration.
# SUNRISE_KEYCLOAK_RGW_CLIENT_ID=rgw-client-public-browser
# SUNRISE_RGW_STS_SESSION_DURATION=3600
SUNRISE_KEYCLOAK_RGW_CLIENT_ID_ATMOSPHERE1=rgw-client-public-browser
SUNRISE_RGW_STS_SESSION_DURATION_ATMOSPHERE1=3600
# SUNRISE_KEYCLOAK_RGW_CLIENT_ID_ATMOSPHERE2=
# SUNRISE_RGW_STS_SESSION_DURATION_ATMOSPHERE2=3600

# In Kubernetes, keep non-sensitive values in the workload or a ConfigMap and
# inject each confidential client secret from a Secret. For example:
# env:
#   - name: SUNRISE_KEYCLOAK_CLIENT_SECRET_ATMOSPHERE1
#     valueFrom:
#       secretKeyRef:
#         name: sunrise-oidc
#         key: atmosphere1-client-secret

NODE_TLS_REJECT_UNAUTHORIZED=0 # if running against self-signed certificates.
